{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DvaForDev Whiteboard Studio",
  "version": "0.1.0",
  "identifier": "dev.dvafordev.whiteboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DvaForDev Whiteboard Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1030,
        "minHeight": 690,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}